# URL of the backend model API (serve.py running on the Vast.ai GPU instance).
# Use the Cloudflare Tunnel hostname once wired, e.g. https://api.mugi-tech.com
BACKEND_API_URL=https://api.mugi-tech.com

# Vast.ai instance auth token (Caddy edge auth) -- if the backend is exposed
# directly instead of through a named Cloudflare Tunnel that bypasses Caddy,
# this must match $OPEN_BUTTON_TOKEN / $WEB_PASSWORD on the instance.
BACKEND_API_TOKEN=
